<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900.0" prefHeight="560.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.danhba.controller.LienHeController">

    <!-- Thanh ben: Nhom (Bang 4.9) -->
    <left>
        <VBox spacing="8.0" prefWidth="200.0" style="-fx-background-color: #f4f4f4;">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
            <Label text="NHÓM" style="-fx-font-weight: bold;" />
            <ListView fx:id="lvNhom" VBox.vgrow="ALWAYS" onMouseClicked="#xuLyChonNhom" />
            <Button fx:id="btnThemNhom" text="Thêm nhóm" maxWidth="Infinity" onAction="#xuLyMoQuanLyNhom" />
            <Button fx:id="btnThongKe" text="Thống kê" maxWidth="Infinity" onAction="#xuLyMoThongKe" />
        </VBox>
    </left>

    <!-- Giua: thanh tim kiem + bang danh sach -->
    <center>
        <VBox spacing="8.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>

            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtTimKiem" promptText="Tìm theo họ tên, số điện thoại hoặc email..." HBox.hgrow="ALWAYS" />
                <Button fx:id="btnTimKiem" text="Tìm kiếm" onAction="#xuLyTimKiem" />
                <Button fx:id="btnLamMoi" text="Làm mới" onAction="#xuLyLamMoi" />
            </HBox>

            <HBox spacing="8.0">
                <Button fx:id="btnThem" text="Thêm" onAction="#xuLyThem" />
                <Button fx:id="btnSua" text="Sửa" onAction="#xuLySua" />
                <Button fx:id="btnXoa" text="Xóa" onAction="#xuLyXoa" />
                <Button fx:id="btnYeuThich" text="★ Yêu thích" onAction="#xuLyDanhDauYeuThich" />
                <Button fx:id="btnNhapCsv" text="Nhập CSV" onAction="#xuLyNhapCsv" />
                <Button fx:id="btnXuatCsv" text="Xuất CSV" onAction="#xuLyXuatCsv" />
            </HBox>

            <TableView fx:id="tvLienHe" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colYeuThich" text="★" prefWidth="40.0" />
                    <TableColumn fx:id="colHoTen" text="Họ tên" prefWidth="200.0" />
                    <TableColumn fx:id="colSoDienThoai" text="Số điện thoại" prefWidth="140.0" />
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180.0" />
                    <TableColumn fx:id="colNhom" text="Nhóm" prefWidth="140.0" />
                </columns>
            </TableView>

            <Label fx:id="lblTrangThai" style="-fx-text-fill: gray;" />
        </VBox>
    </center>
</BorderPane>
