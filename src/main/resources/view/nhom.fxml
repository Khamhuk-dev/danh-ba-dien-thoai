<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefWidth="480.0" prefHeight="420.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.danhba.controller.NhomController">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
    </padding>

    <Label text="QUẢN LÝ NHÓM LIÊN HỆ" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

    <TableView fx:id="tvNhom" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTenNhom" text="Tên nhóm" prefWidth="180.0" />
            <TableColumn fx:id="colMoTa" text="Mô tả" prefWidth="180.0" />
            <TableColumn fx:id="colSoLuong" text="Số liên hệ" prefWidth="90.0" />
        </columns>
    </TableView>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtTenNhom" promptText="Tên nhóm" HBox.hgrow="ALWAYS" />
        <TextField fx:id="txtMoTa" promptText="Mô tả (tùy chọn)" HBox.hgrow="ALWAYS" />
    </HBox>

    <Label fx:id="lblLoi" style="-fx-text-fill: red;" wrapText="true" />

    <HBox spacing="8.0">
        <Button text="Thêm" onAction="#xuLyThem" />
        <Button text="Sửa" onAction="#xuLySua" />
        <Button text="Xóa" onAction="#xuLyXoa" />
        <Button text="Làm mới ô nhập" onAction="#xuLyLamMoi" />
        <Button text="Đóng" onAction="#xuLyDong" />
    </HBox>
</VBox>
