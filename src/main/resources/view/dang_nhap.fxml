<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" prefWidth="360.0" prefHeight="300.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.danhba.controller.DangNhapController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
    </padding>

    <Label text="QUẢN LÝ DANH BẠ ĐIỆN THOẠI" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <Label text="Đăng nhập để tiếp tục" style="-fx-text-fill: gray;" />

    <TextField fx:id="txtTenDangNhap" promptText="Tên đăng nhập" maxWidth="260.0" />
    <PasswordField fx:id="txtMatKhau" promptText="Mật khẩu" maxWidth="260.0" />

    <Label fx:id="lblThongBao" style="-fx-text-fill: red;" wrapText="true" maxWidth="260.0" />

    <Button fx:id="btnDangNhap" text="Đăng nhập" defaultButton="true" prefWidth="140.0"
            onAction="#xuLyDangNhap" />
</VBox>
